{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "./dist",
		"declaration": false,
		"sourceMap": false,
		"module": "ESNext",
		"target": "ES2020",
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": false,
		"noEmit": false
	},
	"include": [
		"index.tsx",
		"main.tsx",
		"components/**/*.tsx",
		"data/**/*.json"
	]
}
